# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# PostgreSQL (or set a single DATABASE_URL=postgres://user:pass@host:5432/name instead)
DB_NAME=vacation_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
PUBLIC_BASE_URL=http://10.0.2.2:8000      # URL phones/WebViews use to reach this server (production: https://vacationequb.com)
APP_DEEP_LINK=ethiovacation://payment-result
SUPPORT_EMAIL=support@ethiovacation.com    # shown on /privacy/ and /account/delete/ – use an inbox you read

# --- Business rules ---
SEAT_LOCK_MINUTES=10
BOOKING_PAYMENT_WINDOW_MINUTES=30
REFERRAL_BONUS_ENTRIES=5
COMPANY_PROFIT_PERCENT=5                  # dashboard profit = this % of revenue
DEFAULT_PAYMENT_PROVIDER=mock             # telebirr | chapa | mock
ENABLE_MOCK_GATEWAY=true                  # MUST be false in production

# --- telebirr (Ethio Telecom merchant credentials) ---
TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
TELEBIRR_WEB_CHECKOUT_URL=https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY_PEM=/run/secrets/telebirr_private.pem
TELEBIRR_PUBLIC_KEY_PEM=/run/secrets/telebirr_public.pem

# --- Chapa (optional second aggregator) ---
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# --- Push ---
PUSH_BACKEND=apps.notifications.push.LogPushBackend   # or apps.notifications.push.ExpoPushBackend
EXPO_ACCESS_TOKEN=
